            color: #4a5568;
            line-height: 1.6;
        }
        
        .contact-map {
            margin-top: 40px;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.05);
        }
        
        .contact-map img {
            width: 100%;
            display: block;
            transition: var(--transition);
        }
        
