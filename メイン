        .news-author {
            display: flex;
            align-items: center;
        }
        
        .news-author-avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            overflow: hidden;
            margin-right: 10px;
        }
        
        .news-author-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        .news-author-name {
            font-size: 0.9rem;
            color: #718096;
        }
        
        .news-read-more {
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--primary-color);
            display: flex;
            align-items: center;
        }
        
        .news-read-more i {
            margin-left: 5px;
            transition: var(--transition);
        }
        
        .news-read-more:hover i {
            transform: translateX(5px);
        }
        
