            font-size: 18px;
            margin-bottom: 10px;
            color: #2c5282;
        }
        
        /* プロセス */
        .process-steps {
            counter-reset: step;
            margin-top: 30px;
        }
        
        .process-step {
            margin-bottom: 20px;
            padding-left: 50px;
            position: relative;
        }
        
        .process-step:before {
            content: counter(step);
            counter-increment: step;
            position: absolute;
            left: 0;
            top: 0;
            width: 36px;
            height: 36px;
            background-color: #2c5282;
            color: #fff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }
        
        .process-step h3 {
            font-size: 18px;
            margin-bottom: 10px;
            color: #2c5282;
        }
        
        /* 料金表 */
        .price-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        
        .price-table th,
        .price-table td {
            padding: 12px 15px;
