            background-color: #f8f9fa;
            padding: 80px 0 40px;
            margin-top: 60px;
            text-align: center;
        }
        
        .page-title {
            font-size: 28px;
            margin-bottom: 10px;
            color: #2c5282;
        }
        
        .page-description {
            color: #666;
            max-width: 600px;
            margin: 0 auto;
        }
        
        /* サービス詳細 */
        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
